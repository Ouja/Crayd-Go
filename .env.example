# Copy to .env (which is git-ignored) and edit. Real environment variables override this file.

# development (default): views reload when edited. production: stricter checks, no reload.
APP_ENV=development

# Listen address. PORT=8080 also works (hosting platforms set it).
ADDR=:8080

# Sessions and cache. Pick one; with neither, they live in memory and vanish on restart.
# Production requires REDIS_ADDR or SESSION_SECRET.
#REDIS_ADDR=localhost:6379
#SESSION_SECRET=use-at-least-32-random-characters-here

# Only for testing over plain HTTP on a LAN IP (http://localhost works without it).
#INSECURE_COOKIES=1

# How long running requests may take to finish when the app is stopped.
#SHUTDOWN_TIMEOUT=15s

# Database. Without it, users and orders live in memory. Required in production.
#DB_DSN=user:pass@tcp(localhost:3306)/crayd
#DB_DSN=postgres://user:pass@localhost:5432/crayd?sslmode=disable

# Apply migrations/ on start. Default: on in development, off in production (use `go run . migrate`).
#AUTO_MIGRATE=1
